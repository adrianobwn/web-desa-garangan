# Salin ke .env dan isi. JANGAN commit .env.
DATABASE_URL="postgresql://user:password@localhost:5432/desa_garangan"

# Hanya untuk basis data ber-pooler (mis. Neon). Migrasi butuh advisory lock
# yang tidak tersedia lewat koneksi pooled, jadi isi dengan URL yang sama
# tanpa "-pooler". Kosongkan bila PostgreSQL biasa/lokal.
DIRECT_URL=""

# Rahasia sesi Auth.js — buat dengan: npx auth secret  (atau openssl rand -base64 32)
AUTH_SECRET=""

# URL situs (dipakai sitemap, metadata SEO, callback Auth.js)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary — dashboard.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Akun admin yang dibuat `npm run db:seed`. Isi SEBELUM menjalankan seed;
# kalau dikosongkan, seed memakai nilai bawaan di prisma/seed.ts.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""
