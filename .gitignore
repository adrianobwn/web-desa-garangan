# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# .env.example harus ikut ter-commit (template tanpa rahasia)
!.env.example
app/generated/

# Berkas sumber data warga (berisi NIK & data pribadi) - JANGAN di-commit
*.xlsx
*.xls

# Foto asli dari HP (HEIC) — versi web ada di public/foto/
*.HEIC
*.heic
